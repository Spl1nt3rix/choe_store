flowchart TD
    A([Начало]) --> B[/Ввод логина и пароля/]
    B --> C[Поиск пользователя по логину]
    C --> D{Пользователь найден?}
    D -- Нет --> E[/Сообщение об ошибке/]
    E --> Z([Конец])
    D -- Да --> F[Проверка пароля по bcrypt-хешу]
    F --> G{Пароль верный?}
    G -- Нет --> H[/Сообщение об ошибке/]
    H --> Z
    G -- Да --> I[Определение роли пользователя]
    I --> J[/Открытие доступного интерфейса/]
    J --> Z
